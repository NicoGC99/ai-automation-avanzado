              "type": "string"
            },
            {
              "id": "set-name",
              "name": "remitente_nombre",
              "value": "={{ $json.from.value[0].name || $json.from.value[0].address.split('@')[0] }}",
              "type": "string"
            },
            {
              "id": "set-subject",
              "name": "asunto",
              "value": "={{ $json.subject }}",
              "type": "string"
            },
            {
              "id": "set-body",
