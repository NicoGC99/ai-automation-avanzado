        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "filt-1",
              "leftValue": "={{ $json.subject }}",
              "rightValue": "auto-reply",
              "operator": {
                "type": "string",
                "operation": "notContains"
              }
            },
            {
              "id": "filt-2",
              "leftValue": "={{ $json.subject }}",
              "rightValue": "out of office",
              "operator": {
                "type": "string",
                "operation": "notContains"
              }
            },
            {
              "id": "filt-3",
              "leftValue": "={{ $json.subject }}",
              "rightValue": "undeliverable",
              "operator": {
                "type": "string",
                "operation": "notContains"
              }
            },
            {
              "id": "filt-4",
              "leftValue": "={{ $json.from.value[0].address }}",
              "rightValue": "no-reply@",
              "operator": {
                "type": "string",
                "operation": "notContains"
              }
            },
            {
              "id": "filt-5",
              "leftValue": "={{ $json.from.value[0].address }}",
              "rightValue": "noreply@",
              "operator": {
                "type": "string",
                "operation": "notContains"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b665616a-c6a5-421d-89fc-1d16fe7979b8",
      "name": "IF - Filtrar Auto-respuestas",
